  "consistency_rules": [
    {
      "applies_to": "Fasteners",
      "rule": "diameter_mm must be less than length_mm for standard bolts",
      "severity": "warning"
    },
    {
      "applies_to": "Bearings",
      "rule": "outer_diameter_mm must be greater than bore_diameter_mm",
      "severity": "error"
    },
    {
      "applies_to": "Motors & Drives",
      "rule": "rpm should correlate with pole count typical ranges (2-pole ~3000rpm, 4-pole ~1500rpm, 6-pole ~1000rpm at 50Hz)",
      "severity": "warning"
    },
    {
      "applies_to": "Pumps",
      "rule": "outlet_size_mm is typically less than or equal to inlet_size_mm",
      "severity": "warning"
    },
    {
      "applies_to": "Valves",
      "rule": "max_temp_c should be consistent with stated material (e.g. PVC valves should not exceed ~60C)",
      "severity": "warning"
    }
  ]
