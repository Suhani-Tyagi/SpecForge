# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# App API Key for backend pipeline protection (optional in dev, enforced in prod)
APP_API_KEY=specforge_dev_secret_key_123

# Frontend API key matching APP_API_KEY (injected into client at build time if API auth is required)
VITE_APP_API_KEY=specforge_dev_secret_key_123

# Allowed CORS Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://spec-forge.vercel.app

# Server Configuration
PORT=3001
NODE_ENV=development
